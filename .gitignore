# .NET build output
bin/
obj/
*.user

# NuGet
*.nupkg
.nuget/
packages/

# IDE
.vs/
.idea/
*.suo
*.sln.docstates

# OS
.DS_Store
Thumbs.db

# Mac app
mac/.build/
# Xcode per-user state (paths, UI/scheme state) — anywhere in the tree, not just top level
**/xcuserdata/
*.xcuserstate
mac/**/DerivedData/

# Runtime/diagnostic logs
*.log

# Claude Code — personal, per-machine settings (shared .claude/settings.json is fine to commit)
.claude/settings.local.json

# Internal deep-reference docs (kept local; the public docs are README.md + PROTOCOL.md)
/ARCHITECTURE.md
/DECISIONS.md

# Third-party virtual-display-rs CLI (provided per-machine, not committed)
windows/Montogo.App/driver/

# Windows installer build artifacts (fetched/produced by installer/windows/build.ps1).
# The pinned driver is documented in installer/windows/driver-pin.md and fetched by hash.
/installer/windows/driver/
/installer/windows/build/
/installer/windows/dist/

# Mac installer build artifacts (produced by installer/mac/build-dmg.sh)
/installer/mac/build/
/installer/mac/dist/

# Logo source masters — kept local only; the built app icons are committed in each
# project (windows/Montogo.App/montogo.ico, mac Assets.xcassets/AppIcon).
/branding/
