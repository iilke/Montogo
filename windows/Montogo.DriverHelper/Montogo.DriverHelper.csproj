<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Always runs elevated: it is the only component allowed to touch the v0.3.1
         driver's admin-only control pipe, so the main app can stay non-elevated. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Montogo.Driver\Montogo.Driver.csproj" />
  </ItemGroup>

</Project>
