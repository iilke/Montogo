<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Montogo.Driver\Montogo.Driver.csproj" />
    <ProjectReference Include="..\Montogo.Capture\Montogo.Capture.csproj" />
    <ProjectReference Include="..\Montogo.Encoding\Montogo.Encoding.csproj" />
    <ProjectReference Include="..\Montogo.Transport\Montogo.Transport.csproj" />
    <ProjectReference Include="..\Montogo.Protocol\Montogo.Protocol.csproj" />
    <!-- Elevated helper: built before the app, but not referenced as code — the app only
         launches its exe at runtime (to control the admin-only driver pipe). -->
    <ProjectReference Include="..\Montogo.DriverHelper\Montogo.DriverHelper.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the helper's exe (+ its runtimeconfig/deps/dlls) next to Montogo.App.exe so the
       app can find and launch it. -->
  <Target Name="CopyDriverHelper" AfterTargets="Build">
    <ItemGroup>
      <_DriverHelperFiles Include="$(MSBuildProjectDirectory)\..\Montogo.DriverHelper\bin\$(Configuration)\$(TargetFramework)\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DriverHelperFiles)"
          DestinationFolder="$(OutDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- DPAPI (ProtectedData) is not in the shared framework on .NET 8; it ships as
       a NuGet package even for Windows-targeted apps. Used to encrypt the connection
       code at rest in settings.json. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>montogo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Ship the multi-resolution app icon next to the exe so the tray can load its
       16/32 px frame at the right DPI (the embedded ApplicationIcon covers the
       exe/taskbar; NotifyIcon needs a small-size frame explicitly). -->
  <ItemGroup>
    <Content Include="montogo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>