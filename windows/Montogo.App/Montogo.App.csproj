<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Montogo.Driver\Montogo.Driver.csproj" />
    <ProjectReference Include="..\Montogo.Capture\Montogo.Capture.csproj" />
    <ProjectReference Include="..\Montogo.Encoding\Montogo.Encoding.csproj" />
    <ProjectReference Include="..\Montogo.Transport\Montogo.Transport.csproj" />
    <ProjectReference Include="..\Montogo.Protocol\Montogo.Protocol.csproj" />
  </ItemGroup>

  <!-- DPAPI (ProtectedData) is not in the shared framework on .NET 8; it ships as
       a NuGet package even for Windows-targeted apps. Used to encrypt the connection
       code at rest in settings.json. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Copy the virtual-display-rs CLI into driver\ next to the built exe for every
       build config, so CliPathResolver finds it in Debug and Release alike.
       The binary is provided per-machine (see driver\ in the source tree) and is
       git-ignored, matching the "user installs the driver separately" design. -->
  <ItemGroup>
    <None Include="driver\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>